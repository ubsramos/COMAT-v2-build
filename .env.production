# ==============================================================================
# VARIÁVEIS DE AMBIENTE — PRODUÇÃO COMAT v2
# Este arquivo é gerado/atualizado automaticamente pelo install_server.sh
# ==============================================================================

# Conexão com o banco de dados MySQL do Host Linux (via host.docker.internal)
DATABASE_URL=mysql://comat_user:SENHA_AQUI@host.docker.internal:3306/comat_db

# Chave secreta de autenticação JWT
SECRET_KEY=comat-v2-production-jwt-security-key-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Upload de fotos
UPLOAD_DIR=/var/www/html/backend/uploads
LEGACY_UPLOAD_DIR=

APP_NAME=COMAT
APP_VERSION=2.1

# Integração LDAP (Opcional - deixe vazio para autenticação local pura)
LDAP_SERVER=
LDAP_DOMAIN=
LDAP_BASE_DN=
